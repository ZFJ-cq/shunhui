PORT=33101
NODE_ENV=development
# Set a random 48+ byte secret before production.
JWT_SECRET=replace-with-a-long-random-secret
# Optional MySQL URL; local dev defaults to durable SQLite in data/meeting.sqlite.
# DATABASE_URL=mysql://meeting:change-me@127.0.0.1:3306/meeting
DB_FILE=data/meeting.sqlite
# Publicly reachable server IP / DNS. Use 127.0.0.1 for local browser testing.
RTC_LISTEN_IP=0.0.0.0
RTC_ANNOUNCED_IP=127.0.0.1
RTC_MIN_PORT=40000
RTC_MAX_PORT=40100
ROOM_MAX_MEDIA_STREAMS=75
PEER_MAX_INCOMING_BITRATE=6000000
PEER_MAX_OUTGOING_BITRATE=8000000
ICE_SERVERS=[]
STUN_URLS=stun:stun.l.google.com:19302
# Optional public invite origin (domain/LAN URL); unset to follow the request origin.
APP_ORIGIN=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Coturn REST authentication. Set TURN_ENABLED=true and configure a 32+ character
# shared secret that exactly matches coturn's static-auth-secret.
TURN_ENABLED=false
TURN_TTL_SECONDS=86400
TURN_URLS=
TURN_TCP_URL=
TURN_SECRET=
# Optional split media service (must match sfu-server)
SFU_URL=
INTERNAL_SECRET=
# Local TLS: mkcert localhost 127.0.0.1 ::1, then set paths
HTTPS_CERT=
HTTPS_KEY=
