{
  "name": "webmeeting-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:https": "VITE_HTTPS=1 concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "sfu": "node server/sfu-server.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "dotenv": "^18.0.8",
    "element-plus": "^2.9.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-vue-next": "^0.468.0",
    "mediasoup": "3.15.8",
    "mediasoup-client": "^3.25.1",
    "mysql2": "^3.24.6",
    "pinia": "^2.3.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^10.0.6",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
