{
  "info": {
    "name": "瞬会 WebMeeting API",
    "description": "瞬会 MVP 全部 REST 接口。先执行游客或账号登录以保存 token。会议文件夹按顺序可完成创建→入会→聊天→离会→结束。入会后30秒内需要建立 Socket.IO 连接；媒体信令见 docs/signaling.md。主持人控制和管理员操作请单独选择执行，管理员需先以管理员凭证登录。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:33101"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "meetingId",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "phone",
      "value": ""
    },
    {
      "key": "accountPassword",
      "value": ""
    },
    {
      "key": "targetUserId",
      "value": ""
    },
    {
      "key": "scheduledId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "用户",
      "item": [
        {
          "name": "游客登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"Postman访客\"\n}"
            },
            "url": "{{baseUrl}}/api/user/guest-login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.expect(pm.response.code).to.eql(200);",
                  "pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "账号或管理员登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/user/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"password\": \"{{accountPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('登录成功', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "当前用户",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/user/me"
          }
        }
      ]
    },
    {
      "name": "会议",
      "item": [
        {
          "name": "创建即时会议",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman 演示会议\",\n  \"password\": \"123456\",\n  \"maxParticipants\": 25,\n  \"defaultMute\": true\n}"
            },
            "url": "{{baseUrl}}/api/meetings/create"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.expect(pm.response.code).to.eql(200);",
                  "pm.collectionVariables.set('meetingId', body.data.id);",
                  "pm.collectionVariables.set('password', '123456');"
                ]
              }
            }
          ]
        },
        {
          "name": "我的会议",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/meetings"
          }
        },
        {
          "name": "会议详情",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}"
          }
        },
        {
          "name": "加入会议",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"Postman访客\",\n  \"password\": \"{{password}}\",\n  \"audioOff\": true,\n  \"videoOff\": true\n}"
            },
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}/join"
          }
        },
        {
          "name": "在线参会人",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}/participants"
          }
        },
        {
          "name": "聊天历史",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}/chat"
          }
        },
        {
          "name": "发送聊天",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"来自 Postman 的消息\"\n}"
            },
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}/chat/send"
          }
        },
        {
          "name": "离开会议",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}/leave"
          }
        },
        {
          "name": "结束会议（主持人）",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}/end"
          }
        }
      ]
    },
    {
      "name": "预约（单独执行）",
      "item": [
        {
          "name": "预约会议",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/meetings/schedule",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"meeting_title\": \"未来会议\",\n  \"start_time\": \"{{futureStart}}\",\n  \"duration\": 60,\n  \"max_participants\": 25,\n  \"default_mute\": true,\n  \"join_before_host\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set('futureStart', new Date(Date.now() + 3600000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('scheduledId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "取消预约",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/meetings/{{scheduledId}}"
          }
        }
      ]
    },
    {
      "name": "主持人控制（单独执行）",
      "item": [
        {
          "name": "全员静音",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}/participant/mute",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetUserId\": \"all\",\n  \"media\": \"audio\",\n  \"mute\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "邀请成员开麦",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}/participant/mute",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetUserId\": \"{{targetUserId}}\",\n  \"media\": \"audio\",\n  \"mute\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "关闭成员视频",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}/participant/mute",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetUserId\": \"{{targetUserId}}\",\n  \"media\": \"video\",\n  \"mute\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "移除成员",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}/participant/{{targetUserId}}"
          }
        },
        {
          "name": "锁定会议",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}/lock",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"locked\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "解锁会议",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}/lock",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"locked\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "关闭聊天",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}/chat",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chatClosed\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "开放聊天",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}/chat",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chatClosed\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "管理员",
      "item": [
        {
          "name": "管理概览",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/overview"
          }
        },
        {
          "name": "管理员结束会议",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/meetings/{{meetingId}}/end"
          }
        },
        {
          "name": "创建账号",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"13900000000\",\n  \"nickname\": \"普通用户\",\n  \"password\": \"set-a-new-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "禁用用户",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/users/{{targetUserId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"disabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "启用用户",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/users/{{targetUserId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"disabled\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
